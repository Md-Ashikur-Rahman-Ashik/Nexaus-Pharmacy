name: pharmacy_app
description: "A new Flutter project."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.12.0

dependencies:
  flutter:
    sdk: flutter
  sqlite3: ^3.3.0
  path: ^1.9.0
  path_provider: ^2.1.2
  flutter_riverpod: ^3.0.0
  intl: ^0.20.0
  share_plus: ^12.0.0
  file_picker: 10.3.10

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.1

flutter:
  uses-material-design: true